# ─────────────────────────────────────────────────────────────
# 1) 문구 생성 (필수)
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─────────────────────────────────────────────────────────────
# 2) 홈페이지 자동 조작 시 로그인이 필요할 때 (선택)
#    flow yaml 안에서 ${SITE_ID} / ${SITE_PW} 로 참조합니다.
# ─────────────────────────────────────────────────────────────
SITE_ID=
SITE_PW=

# ─────────────────────────────────────────────────────────────
# 3) 발행 채널 — 쓰는 것만 채우면 됩니다. 비어 있으면 자동으로 건너뜁니다.
# ─────────────────────────────────────────────────────────────

# Postiz (한 번에 여러 플랫폼. 가장 추천하는 방법)
#  ※ POSTIZ_API_KEY 는 Postiz 설정 > Public API 에서 발급하는 키입니다.
#     채널 연결용 CLIENT_ID / CLIENT_SECRET 과는 다른 값이고,
#     그것들은 셀프호스팅 Postiz "서버"의 환경변수로 들어갑니다 (여기 아님).
POSTIZ_API_URL=https://api.postiz.com
POSTIZ_API_KEY=
# (선택) 채널을 고정하고 싶을 때만. 비워두면 연결된 채널에서 자동으로 찾습니다.
# `channels` 명령이 아래 줄을 그대로 만들어 줍니다.
POSTIZ_INTEGRATIONS=

# X (Twitter) — OAuth 1.0a User Context
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Threads (Meta)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Instagram (Instagram Graph API / 비즈니스 계정 필요)
IG_USER_ID=
IG_ACCESS_TOKEN=
# 릴스는 "공개 URL"이 필요합니다. 렌더 결과물을 올려둘 정적 호스팅의 베이스 URL.
PUBLIC_MEDIA_BASE_URL=

# YouTube Shorts (OAuth2 refresh token)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# 범용 웹훅 (n8n / Make / Zapier / Slack 등)
WEBHOOK_URL=
